{
    "name": "laravel-artifacts/laravel-artifacts",
    "description": "Intelligent artifact management for Laravel with AI-powered content generation and merging",
    "keywords": [
        "laravel",
        "artifacts",
        "ai",
        "documentation",
        "content-generation",
        "merge"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Laravel Artifacts Team",
            "email": "team@laravel-artifacts.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "illuminate/database": "^11.0",
        "illuminate/validation": "^11.0",
        "illuminate/console": "^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "LaravelArtifacts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelArtifacts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelArtifacts\\LaravelArtifactsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
